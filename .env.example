ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

MODEL_NAME=transaction-risk-model
MODEL_VERSION=local

MODEL_SOURCE=local
MODEL_ARTIFACT_PATH=artifacts/models/random_forest.joblib
MODEL_EVALUATION_REPORT_PATH=artifacts/evaluation_report.json

# SQLite prediction-event store; the API queues successful predictions asynchronously.
ML_MONITORING_DATABASE_PATH=artifacts/monitoring/events.sqlite3
ML_MONITORING_QUEUE_MAXSIZE=5000
ML_MONITORING_RETENTION_DAYS=90

# Set both values for an authenticated internal API. Do not commit the real key.
API_AUTH_ENABLED=false
# API_KEY=replace-with-a-long-random-secret

# Optional for loopback-only local use; set before sharing the Grafana workstation/session.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Required by `make up` and `make up-tracking`; use unique local development secrets.
# Keep POSTGRES_PASSWORD hexadecimal so it is safe in the SQLAlchemy URL used by MLflow.
# Generate independent values with: python -c "import secrets; print(secrets.token_hex(24))"
# POSTGRES_PASSWORD=<48-character-random-hex>
# MINIO_ROOT_USER=<at-least-16-character-random-hex>
# MINIO_ROOT_PASSWORD=<48-character-random-hex>
# MLFLOW_PORT=5000
